{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-claw",
  "main": "./src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "upload_source_maps": true,
  "keep_vars": true,
  "observability": {
    "traces": {
      "enabled": true,
    },
    "logs": {
      "enabled": true,
    },
  },
  "placement": {
    "region": "aws:us-west-2",
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true,
  },
  "containers": [
    {
      "name": "cloud-claw-container",
      "class_name": "AgentContainer",
      "image": "./Dockerfile",
      "ssh": {
        "enabled": true,
      },
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 4096,
        "disk_mb": 8192,
      },
      "max_instances": 1,
      "constraints": {
        "region": ["wnam"],
      },
      "authorized_keys": [
        {
          "name": "greg",
          "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIO7Gje16pyIJEIGX40h07uTIh837IS60ZraDLn7NZcNe greg@MacBook-Air.local",
        },
      ],
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "AgentContainer",
        "name": "AGENT_CONTAINER",
      },
    ],
  },
  // Wake container 5 min before every in-gateway cron job (Cloudflare crons are
  // UTC-only; the tz-aware gateway cron fires at the exact local time). Each
  // Europe/Dublin job needs two wakes — IST (UTC+1) and GMT (UTC+0) — since
  // Cloudflare crons don't observe DST; the spurious wake in the other season
  // just idles ~10 min via sleepAfter. Sourced from `openclaw cron list --all`:
  //   - Memory Dreaming Promotion   0 3 * * *      UTC            -> 02:55
  //   - status-report-morning      0 9 * * *      Europe/Dublin  -> 07:55 / 08:55
  //   - lead-scout                 5 9 * * *      Europe/Dublin  -> 08:00 / 09:00
  //   - daily-standup              15 9 * * 1-5   Europe/Dublin  -> 08:10 / 09:10
  // status-report-afternoon removed 2026-07-22 (broken gmail lookup, duplicate noise).
  // Re-derive this list with `openclaw cron list --all --json` if gateway jobs change.
  "triggers": {
    "crons": ["55 2,7,8 * * *", "0 8,9 * * *", "10 8,9 * * *"],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["AgentContainer"],
      "tag": "container",
    },
  ],
}
